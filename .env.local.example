# LAN-testing template — copy to .env when running locally. The
# docker-compose.override.yml in this repo auto-loads with plain `docker
# compose up` and applies LAN-friendly port mappings.
#
#   cp .env.local.example .env
#   $EDITOR .env                       # replace <LAN_IP> with your dev machine's IP
#   docker compose up -d --build
#
# Differences vs .env.example (the production-leaning template):
#   • CORS_ORIGIN + PAIRING_BASE_URL use http:// (no TLS) and your LAN IP
#   • Strong secrets aren't strictly required — these are dev-only values you'll
#     wipe before pushing anything to a real VPS. Still, don't reuse them in prod.
#
# Find your dev machine's LAN IP:
#   Linux:   ip addr | grep "inet 192"
#   macOS:   ipconfig getifaddr en0
#   Windows: ipconfig | findstr IPv4

DB_USER=rdadmin
DB_PASSWORD=changeme_dev_only

# Dev-only JWT secret — sufficient length, not for production reuse.
JWT_SECRET=dev_only_jwt_secret_at_least_32_chars_long

# Replace <LAN_IP> with your dev machine's address, e.g. http://192.168.1.10:3000
CORS_ORIGIN=http://<LAN_IP>:3000
PAIRING_BASE_URL=http://<LAN_IP>:3000

# Web container port mapping — defaults are fine
WEB_TLS_PORT=443

# Initial admin seeded on first boot. Email is the login identifier. Leave
# both blank to fall back to admin@local / admin (the seed will print a
# loud warning).
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=changeme_dev_only

# TURN stays off for LAN testing — STUN-only is enough since both peers are on
# the same network and can pair via host candidates. Leave commented.
# TURN_SECRET=
# TURN_HOSTNAME=
# TURN_PORT=3478
